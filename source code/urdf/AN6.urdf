</gazebo>

<!--Defination of plugins-->
<gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
        <robotNamespace>/mubot</robotNamespace>
    </plugin>
</gazebo>

<gazebo>
   <plugin name="hydro_plugin" filename="libHydro.so">
       <num_actuators>6</num_actuators> 
   </plugin>
   <plugin name="actuator_plugin" filename="libActuatorPlugin.so">
       <num_actuators>6</num_actuators>
   </plugin>
</gazebo>


</robot>
