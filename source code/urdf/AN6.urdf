<?xml version="1.0" encoding="utf-8"?>
<robot
  name="mubot">


<!--Defination of links: head, body, peduncle and tail -->


<link
  name="dummy_link">
  <inertial>
    <origin
      xyz="0.02857 0.0 0.0"
      rpy="0 0 0" />
    <mass
      value="1.967E-02" />
    <inertia
      ixx="5.351E-07"
      ixy="0.0"
      ixz="0.0"
      iyy="7.136E-07"
      iyz="0.0"
      izz="6.043E-06" />
  </inertial>
  <visual>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <geometry>
      <mesh
        filename="package://des_mubot/meshes/segment_head.STL" scale="1 1 1"/>
    </geometry>
    <material
      name="">
      <color
        rgba="1 0 0 1" />
    </material>
  </visual>
  <collision>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <geometry>
      <mesh
        filename="package://des_mubot/meshes/segment_head.STL" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

