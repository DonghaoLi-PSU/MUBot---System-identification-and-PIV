      rpy="0 0 0" />
    <geometry>
      <mesh
        filename="package://des_mubot/meshes/segment_body.STL" scale="1 1 1"/>
    </geometry>
  </collision>
</link>


<link name="segment_head">
</link>
<joint
name="dummy joint" type="fixed">
<parent
  link="segment_head" />
<child
  link="dummy_link" />
</joint>


